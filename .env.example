# Copie automatique en .env par setup.sh (les mots de passe vides y sont generes)
# Ne jamais versionner le fichier .env.
WAZUH_VERSION=4.14.8
TZ=Africa/Nouakchott
# Memoire Java de l'indexer : environ 1/4 de la RAM (16 Go -> 4g, 8 Go -> 2g, 4 Go -> 1g)
INDEXER_HEAP=4g
# Port HTTPS du tableau de bord. Vide : 443, ou 8443 si 443 est deja utilise (choisi par setup.sh)
DASHBOARD_PORT=

# Mots de passe : 8 a 64 caracteres, avec majuscule, minuscule, chiffre et symbole.
# Laisser vide pour que setup.sh les genere.
INDEXER_ADMIN_PASSWORD=
DASHBOARD_PASSWORD=
API_PASSWORD=
# Mot de passe d'enrolement des agents (port 1515)
ENROLLMENT_PASSWORD=
# Compte en lecture seule de l'indexer, pour Grafana et l'exporteur Prometheus
GRAFANA_INDEXER_PASSWORD=
