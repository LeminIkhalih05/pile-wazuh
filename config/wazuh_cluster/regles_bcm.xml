<!-- Regles BCM : journaux de la passerelle Tyk collectes depuis Docker (format json, champ "log").
     Copiees par setup.sh dans /var/ossec/etc/rules/ du manager. Identifiants 100100-100199. -->
<group name="bcm,tyk,">

  <!-- Toute ligne de journal Tyk (base des regles suivantes, non affichee) -->
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="log" type="pcre2">level=(warning|error|fatal).*(mw=|api_name=|tyk)</field>
    <description>Tyk : message d'avertissement ou d'erreur</description>
  </rule>

  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <field name="log" type="pcre2">(?i)(non-existent key|invalid key|key not authorized|key has expired|access to this api has been disallowed)</field>
    <description>Tyk : acces refuse (cle ou jeton invalide)</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100102" level="5">
    <if_sid>100100</if_sid>
    <field name="log" type="pcre2">(?i)(jwt|signature|token).*(fail|invalid|expired|not valid)</field>
    <description>Tyk : jeton JWT refuse</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100103" level="6">
    <if_sid>100100</if_sid>
    <field name="log" type="pcre2">(?i)(rate limit|quota) (exceeded|reached)|too many requests</field>
    <description>Tyk : limite de debit ou quota depasse</description>
  </rule>

  <rule id="100104" level="10" frequency="20" timeframe="60">
    <if_matched_sid>100101</if_matched_sid>
    <description>Tyk : nombreux acces refuses en moins d'une minute (attaque possible)</description>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100105" level="10" frequency="20" timeframe="60">
    <if_matched_sid>100102</if_matched_sid>
    <description>Tyk : nombreux jetons JWT refuses en moins d'une minute (attaque possible)</description>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100106" level="8">
    <if_sid>100100</if_sid>
    <field name="log" type="pcre2">level=(error|fatal)</field>
    <field name="log" type="pcre2">(?i)(redis|upstream|connection refused|proxy error)</field>
    <description>Tyk : erreur de la passerelle (Redis ou service en amont)</description>
  </rule>

</group>
