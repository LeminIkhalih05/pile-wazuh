   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true
      },
      "renameByName": {
       "job": "Job",
       "instance": "Cible",
       "Value": "État"
      }
     }
    }
   ]
  },
  {
   "id": 7,
   "title": "Alertes Wazuh (5 dernières minutes) par niveau",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "__PROM_UID__"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "__PROM_UID__"
     },
     "expr": "bcm_wazuh_alertes{fenetre=\"5m\"}",
     "format": "time_series",
     "instant": false,
     "range": true,
     "legendFormat": "{{niveau}}"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 14,
    "h": 8
   }
  },
  {
   "id": 8,
   "title": "Redémarrages des conteneurs",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "__PROM_UID__"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "__PROM_UID__"
     },
     "expr": "bcm_conteneur_redemarrages > 0",
     "format": "table",
     "instant": true,
     "range": false,
     "legendFormat": ""
    }
   ],
   "gridPos": {
    "x": 14,
    "y": 14,
    "w": 10,
    "h": 8
   },
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "instance": true,
       "job": true,
       "image": true
      },
      "renameByName": {
       "nom": "Conteneur",
       "projet": "Pile",
       "Value": "Redémarrages"
      }
     }
    }
   ]
  }
 ]
}