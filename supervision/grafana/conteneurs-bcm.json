   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "__PROM_UID__"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "__PROM_UID__"
     },
     "expr": "up",
     "format": "table",
     "instant": true,
     "range": false,
     "legendFormat": ""
    }
   ],
   "gridPos": {
    "x": 14,
    "y": 4,
    "w": 10,
    "h": 10
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
