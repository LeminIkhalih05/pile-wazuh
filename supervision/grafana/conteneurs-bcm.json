   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "__PROM_UID__"
     },
     "expr": "bcm_wazuh_agents{etat=\"active\"}",
     "format": "time_series",
     "instant": true,
     "range": false,
     "legendFormat": ""
