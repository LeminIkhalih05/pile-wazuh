    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "title": "État de tous les conteneurs",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "__PROM_UID__"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "__PROM_UID__"
     },
     "expr": "bcm_conteneur_actif",
     "format": "table",
     "instant": true,
     "range": false,
     "legendFormat": ""
