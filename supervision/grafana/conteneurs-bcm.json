        },
        "1": {
         "text": "En marche",
         "color": "green"
        }
       }
      }
     ],
     "custom": {
      "cellOptions": {
       "type": "color-background"
      }
     }
    },
    "overrides": []
   },
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "instance": true,
       "job": true
      },
      "renameByName": {
       "nom": "Conteneur",
       "projet": "Pile",
       "image": "Image",
       "Value": "État"
      }
     }
    }
   ]
  },
  {
   "id": 6,
