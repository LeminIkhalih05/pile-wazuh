{
 "title": "Supervision – conteneurs et Wazuh",
 "uid": "bcm-conteneurs",
 "tags": [
  "bcm",
  "prometheus"
 ],
 "timezone": "browser",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "schemaVersion": 39,
 "editable": true,
 "panels": [
  {
   "id": 1,
   "title": "Conteneurs en marche",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "__PROM_UID__"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "__PROM_UID__"
     },
     "expr": "sum(bcm_conteneur_actif)",
     "format": "time_series",
     "instant": true,
     "range": false,
     "legendFormat": ""
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 2,
   "title": "Conteneurs arrêtés",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "__PROM_UID__"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "__PROM_UID__"
     },
     "expr": "count(bcm_conteneur_actif == 0) or vector(0)",
     "format": "time_series",
     "instant": true,
     "range": false,
     "legendFormat": ""
    }
   ],
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "title": "Agents Wazuh actifs",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "__PROM_UID__"
