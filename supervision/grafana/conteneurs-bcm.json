   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "__PROM_UID__"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "__PROM_UID__"
     },
     "expr": "bcm_wazuh_agents{etat=\"disconnected\"}",
